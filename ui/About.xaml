<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About Rock Toolbox" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#1F2329" WindowStyle="None" BorderBrush="#2B3038" BorderThickness="1" FontFamily="Segoe UI" FontSize="13">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- @include ui/WizStyles.xaml -->
    <Style x:Key="AboutBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="#2F6FB0" CornerRadius="3" Padding="42,8" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="#FFFFFF" TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid ClipToBounds="True">
    <Border x:Name="aboutRoot" BorderBrush="#2B3038" BorderThickness="1" Padding="30,62,30,26" MinWidth="500">
      <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Viewbox x:Name="aboutLogo" Width="72" Height="72" Margin="0,0,16,0">
            <Canvas Width="40" Height="40">
              <Polygon Points="20,2 4,12 20,20" Fill="#8FEBFF" Stroke="#181B20" StrokeThickness="0.7" StrokeLineJoin="Round"/>
              <Polygon Points="20,2 36,12 20,20" Fill="#4FD1FF" Stroke="#181B20" StrokeThickness="0.7" StrokeLineJoin="Round"/>
              <Polygon Points="4,12 4,28 20,20" Fill="#2F7BFF" Stroke="#181B20" StrokeThickness="0.7" StrokeLineJoin="Round"/>
              <Polygon Points="36,12 36,28 20,20" Fill="#7B5CFF" Stroke="#181B20" StrokeThickness="0.7" StrokeLineJoin="Round"/>
              <Polygon Points="4,28 20,38 20,20" Fill="#4B35C9" Stroke="#181B20" StrokeThickness="0.7" StrokeLineJoin="Round"/>
              <Polygon Points="36,28 20,38 20,20" Fill="#9A6BFF" Stroke="#181B20" StrokeThickness="0.7" StrokeLineJoin="Round"/>
            </Canvas>
          </Viewbox>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ROCK TOOLBOX" FontSize="26" FontWeight="Black" Foreground="White"/>
            <TextBlock Text="Rock Tech - Windows Toolbox" Foreground="#9AA0B8"/>
          </StackPanel>
        </StackPanel>
        <TextBlock Text="Install apps, apply tweaks, debloat Windows, configure features, control updates, set wallpapers and open every Control Panel setting from one place." Foreground="#C9CDE0" TextWrapping="Wrap" MaxWidth="440" Margin="0,18,0,0" TextAlignment="Center"/>
        <Border Background="#1B1F24" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="6" Padding="18,12" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Developer" Foreground="#9AA0B8" Margin="0,4,24,4"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Mohammed" Foreground="#E6E8F2" FontWeight="SemiBold"/>
              <Border Width="24" Height="16" Margin="8,1,0,0" BorderBrush="#2B3038" BorderThickness="0.5" ClipToBounds="True" ToolTip="Egypt">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Rectangle Grid.Row="0" Fill="#CE1126"/><Rectangle Grid.Row="1" Fill="#FFFFFF"/><Rectangle Grid.Row="2" Fill="#000000"/>
                  <Ellipse Grid.Row="1" Width="4.5" Height="4.5" Fill="#C09300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Foreground="#9AA0B8" Margin="0,4,24,4"/>
            <TextBlock x:Name="aboutVersion" Grid.Row="1" Grid.Column="1" Foreground="#4FD1FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Windows" Foreground="#9AA0B8" Margin="0,4,24,4"/>
            <TextBlock x:Name="aboutWindows" Grid.Row="2" Grid.Column="1" Foreground="#E6E8F2" TextWrapping="Wrap" MaxWidth="320" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Credits" Foreground="#9AA0B8" Margin="0,4,24,4"/>
            <TextBlock x:Name="aboutCredits" Grid.Row="3" Grid.Column="1" Text="@OwnerRock" Foreground="#4FD1FF" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand" ToolTip="Open https://t.me/OwnerRock" RenderTransformOrigin="0,0.5">
              <TextBlock.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></TextBlock.RenderTransform>
              <TextBlock.Triggers>
                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></EventTrigger>
              </TextBlock.Triggers>
            </TextBlock>
          </Grid>
        </Border>
        <Button x:Name="btnAboutClose" Content="Close" Style="{StaticResource AboutBtn}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
      </StackPanel>
    </Border>
    <Border VerticalAlignment="Top" Height="36" Background="#181B20" BorderBrush="#2B3038" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button x:Name="btnTitleClose" DockPanel.Dock="Right" Style="{StaticResource TitleClose}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
        </Button>
        <TextBlock Text="About Rock Toolbox" Foreground="#C9CDE0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
