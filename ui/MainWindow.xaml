<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rock Toolbox" Width="1200" Height="780" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#1F2329" BorderBrush="#2B3038" BorderThickness="1" FontFamily="Segoe UI" FontSize="13">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="57" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- @include ui/Styles.xaml -->
  </Window.Resources>

  <Grid x:Name="rootGrid">
    <Grid.Resources>
      <Style x:Key="NavArrowL" TargetType="Button">
        <Setter Property="Foreground" Value="#E6E8F2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Border x:Name="bd" CornerRadius="8" Background="#2B3038" Opacity="0"/>
              <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <ContentPresenter.RenderTransform><TransformGroup><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="tt" X="0"/></TransformGroup></ContentPresenter.RenderTransform>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="-3" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                  <DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.82" Duration="0:0:0.06"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.82" Duration="0:0:0.06"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="cp" Property="Opacity" Value="0.28"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style x:Key="NavArrowR" TargetType="Button">
        <Setter Property="Foreground" Value="#E6E8F2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Border x:Name="bd" CornerRadius="8" Background="#2B3038" Opacity="0"/>
              <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <ContentPresenter.RenderTransform><TransformGroup><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="tt" X="0"/></TransformGroup></ContentPresenter.RenderTransform>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                  <DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.82" Duration="0:0:0.06"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.82" Duration="0:0:0.06"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="cp" Property="Opacity" Value="0.28"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Style>
      <Style x:Key="CapBtn" TargetType="Button">
        <Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C9CDE0"/>
        <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2B3038"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#343A44"/></Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="CapClose" TargetType="Button">
        <Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C9CDE0"/>
        <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E5484D"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#C23B40"/></Trigger>
        </Style.Triggers>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Image x:Name="imgBg" Grid.RowSpan="3" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.4"/>

    <!-- TOP BAR -->
    <Border Grid.Row="0" Background="#181B20" BorderBrush="#2B3038" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" FlowDirection="LeftToRight">
          <Button x:Name="btnMin" Style="{StaticResource CapBtn}" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
          </Button>
          <Button x:Name="btnMax" Style="{StaticResource CapBtn}" ToolTip="Maximize" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid Width="10" Height="10">
              <Path x:Name="pathMax" Data="M2,0.7 H8 A1.3,1.3 0 0 1 9.3,2 V8 A1.3,1.3 0 0 1 8,9.3 H2 A1.3,1.3 0 0 1 0.7,8 V2 A1.3,1.3 0 0 1 2,0.7 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
              <Path x:Name="pathRestore" Visibility="Collapsed" Data="M0.7,3.7 H6 A1.2,1.2 0 0 1 7.2,4.9 V9.3 H2 A1.3,1.3 0 0 1 0.7,8 Z M3.5,3.7 V2 A1.3,1.3 0 0 1 4.8,0.7 H8.5 A1.3,1.3 0 0 1 9.8,2 V5.6 A1.3,1.3 0 0 1 8.5,6.9 H7.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round"/>
            </Grid>
          </Button>
          <Button x:Name="btnClose" Style="{StaticResource CapClose}" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
          </Button>
        </StackPanel>
        <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button x:Name="btnGear" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="22" Padding="9,2" Margin="0"
                  Background="Transparent" BorderBrush="Transparent" Foreground="#E6E8F2" ToolTip="Settings" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform><RotateTransform Angle="0"/></Button.RenderTransform>
            <Button.Triggers>
              <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90" Duration="0:0:0.4">
<DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
</DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.4">
<DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
</DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger>
            </Button.Triggers>
          </Button>
          <Ellipse x:Name="dotGear" Width="10" Height="10" Fill="#E5484D" Stroke="#181B20" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0" IsHitTestVisible="False" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform></Ellipse>
        </Grid>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" FlowDirection="LeftToRight">
          <Button x:Name="btnBack" Style="{StaticResource NavArrowL}" ToolTip="Back (Alt+Left)" IsEnabled="False" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M15,8 H2 M7,3 L2,8 L7,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
          </Button>
          <Button x:Name="btnFwd" Style="{StaticResource NavArrowR}" ToolTip="Forward (Alt+Right)" IsEnabled="False" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M1,8 H14 M9,3 L14,8 L9,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
          </Button>
        </StackPanel>
        <Viewbox x:Name="logoHost" Width="38" Height="38" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
          <Canvas Width="256" Height="256">
            <Border Width="256" Height="256" CornerRadius="58">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF9F0A" Offset="0"/><GradientStop Color="#FF375F" Offset="0.55"/><GradientStop Color="#BF5AF2" Offset="1"/></LinearGradientBrush>
              </Border.Background>
            </Border>
            <Polygon Points="128,50 196,89 128,128 60,89" Fill="#F5FFFFFF"/>
            <Polygon Points="60,89 128,128 128,206 60,167" Fill="#96FFFFFF"/>
            <Polygon Points="196,89 196,167 128,206 128,128" Fill="#CDFFFFFF"/>
          </Canvas>
        </Viewbox>
        <TextBlock Text="ROCK" FontSize="17" FontWeight="Black" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
        <TextBlock x:Name="txtCrumb" FontSize="14" FontWeight="SemiBold" Foreground="#9AA0B8" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="1" Margin="12,10,12,10">
      <Border DockPanel.Dock="Top" Background="#181B20" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="6" Padding="8,8,8,2" Margin="0,0,0,10">
        <WrapPanel x:Name="tabBar" Orientation="Horizontal"/>
      </Border>
      <Grid Margin="0">

      <!-- @include ui/pages/Install.xaml -->

      <!-- @include ui/pages/Tweaks.xaml -->

      <!-- @include ui/pages/Debloat.xaml -->

      <!-- @include ui/pages/Config.xaml -->

      <!-- @include ui/pages/Updates.xaml -->

      <!-- @include ui/pages/Wallpapers.xaml -->

      <!-- @include ui/pages/WindowsUpdate.xaml -->

      <!-- @include ui/pages/UninstallApps.xaml -->

      <!-- @include ui/pages/Drivers.xaml -->

      <!-- @include ui/pages/SystemInfo.xaml -->

      <!-- @include ui/pages/Cleanup.xaml -->

      <!-- @include ui/pages/Startup.xaml -->

      <!-- @include ui/pages/Repair.xaml -->

      <!-- @include ui/pages/GodMode.xaml -->

      <!-- @include ui/pages/Settings.xaml -->

      </Grid>
    </DockPanel>

    <!-- GEAR MENU: a real Popup (StaysOpen=False), so WPF itself closes it on any click outside, on the title bar, and when the window loses focus -->
    <Popup x:Name="popGear" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None" Placement="Bottom" PlacementTarget="{Binding ElementName=btnGear}">
      <Grid x:Name="popGearRoot" Width="460" Margin="12,6,12,18">
    <Border x:Name="menuGear" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
            Width="230" Margin="0" Background="#23272D" BorderBrush="#35506A" BorderThickness="1" CornerRadius="6" Padding="10">
      <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/></Border.Effect>
      <StackPanel>
        <Border x:Name="cardProfile" Cursor="Hand" Background="Transparent" BorderBrush="#2B3038" BorderThickness="0,0,0,1" Padding="4,2,4,12" Margin="0,0,0,8" ToolTip="Edit profile">
          <DockPanel>
            <Grid x:Name="gridAvatar" DockPanel.Dock="Left" Width="50" Height="50" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
              <Ellipse x:Name="elRing" Stroke="#4FD1FF" StrokeThickness="2" Opacity="0" IsHitTestVisible="False"/>
              <Ellipse x:Name="elAvatar" Fill="#B8C0CC" Margin="4"/>
              <Viewbox x:Name="txtAvatarLetter" Stretch="Uniform" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="100" Height="100"><Path Fill="#FFFFFF" Opacity="0.95"><Path.Data><GeometryGroup><EllipseGeometry Center="50,38" RadiusX="17" RadiusY="17"/><PathGeometry Figures="M 13.4 84 C 16 64 34 57 50 57 C 66 57 84 64 86.6 84 A 50 50 0 0 1 13.4 84 Z"/></GeometryGroup></Path.Data></Path></Canvas></Viewbox>
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="txtUserName" Text="User" FontSize="15" FontWeight="SemiBold" Foreground="#F2F4FF" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <Ellipse Width="7" Height="7" Fill="#3DDC84" VerticalAlignment="Center"/>
                <TextBlock Text="Rock Toolbox user" Foreground="#9AA0B8" FontSize="11.5" Margin="6,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
        <Button x:Name="btnGearLang" Style="{StaticResource GearItemBtn}" HorizontalContentAlignment="Stretch" Padding="12,7" Margin="3,3,3,6">
          <DockPanel LastChildFill="False">
            <TextBlock Text="Language" DockPanel.Dock="Left"/>
            <TextBlock x:Name="txtGearLangCur" Text="English  &#x203A;" DockPanel.Dock="Right" Foreground="#9AA0B8"/>
          </DockPanel>
        </Button>
        <CheckBox x:Name="chkGearLight" Style="{StaticResource Switch}" Content="Dark mode" Margin="4,4,4,10"/>
        <Button x:Name="btnGearSettings" Style="{StaticResource GearItemBtn}" Content="Settings" HorizontalContentAlignment="Left" Padding="12,7"/>
        <TextBlock Text="Backup my selections" Foreground="#9AA0B8" FontSize="11" Margin="4,10,4,4"/>
        <Button x:Name="btnProfExport" Style="{StaticResource GearItemBtn}" Content="Export my selections..." HorizontalContentAlignment="Left" Padding="12,7"/>
        <Button x:Name="btnProfImport" Style="{StaticResource GearItemBtn}" Content="Import selections..." HorizontalContentAlignment="Left" Padding="12,7"/>
        <Grid Margin="0,10,0,0">
          <Button x:Name="btnGearUpdate" Style="{StaticResource GearItemBtn}" Content="Check for updates" HorizontalContentAlignment="Left" Padding="12,7"/>
          <Ellipse x:Name="dotGearUpdate" Width="9" Height="9" Fill="#E5484D" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,17,0" IsHitTestVisible="False" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform></Ellipse>
        </Grid>
        <Button x:Name="btnGearAbout" Style="{StaticResource GearItemBtn}" Content="About" HorizontalContentAlignment="Left" Padding="12,7" Margin="3,10,3,3"/>
      </StackPanel>
    </Border>
    <Border x:Name="menuLang" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
            Width="196" Margin="0" Background="#23272D" BorderBrush="#35506A" BorderThickness="1" CornerRadius="6" Padding="6">
      <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/></Border.Effect>
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360"><StackPanel x:Name="spLangList"/></ScrollViewer>
    </Border>

      </Grid>
    </Popup>

    <!-- PROGRESS BAR (replaces the old log box; messages go to the Rock console) -->
    <Border x:Name="statusBar" Grid.Row="2" Background="#181B20" BorderBrush="#2B3038" BorderThickness="0,1,0,0" Padding="16,9">
      <DockPanel>
        <TextBlock x:Name="txtPct" DockPanel.Dock="Right" Text="" Width="52" TextAlignment="Right" Foreground="#4FD1FF" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/>
        <Button x:Name="btnStopGlobal" DockPanel.Dock="Right" Content="Stop" Visibility="Collapsed" Background="#B0343A" Foreground="#FFEEEE" Padding="18,2" Margin="8,0,0,0" ToolTip="Stop the running action"/>
        <TextBlock x:Name="txtStatus" DockPanel.Dock="Left" Text="Ready" Width="430" Foreground="#C9CDE0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
        <ProgressBar x:Name="pbMain" Style="{StaticResource StripeBar}" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#4F8CFF" Background="#0F1116" BorderBrush="#2B3038" BorderThickness="1" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
