<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rock Toolbox" Width="440" Height="500" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1F2329" BorderBrush="#2B3038" BorderThickness="1" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- @include ui/WizStyles.xaml -->
  </Window.Resources>
  <Grid ClipToBounds="True">
    <Canvas IsHitTestVisible="False">
      <Ellipse Width="360" Height="360" Canvas.Left="-140" Canvas.Top="-110" Opacity="0.5"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#40FF9F0A" Offset="0"/><GradientStop Color="#00FF9F0A" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
      <Ellipse Width="420" Height="420" Canvas.Left="200" Canvas.Top="300" Opacity="0.5"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#40BF5AF2" Offset="0"/><GradientStop Color="#00BF5AF2" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
    </Canvas>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <Button x:Name="pBtnClose" DockPanel.Dock="Right" Style="{StaticResource TitleClose}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
        </Button>
        <TextBlock Text="Rock Toolbox" Margin="14,0" VerticalAlignment="Center" Foreground="#9AA0B8" FontSize="12"/>
      </DockPanel>
      <StackPanel x:Name="pRoot" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
        <TextBlock Text="Your profile" FontSize="26" FontWeight="Bold" Foreground="#F2F4FF" HorizontalAlignment="Center"/>
        <Grid x:Name="pAvatarGrid" Tag="pop" Width="124" Height="124" Margin="0,20,0,0" Cursor="Hand" Background="Transparent">
          <Ellipse x:Name="pAvEl" Fill="#B8C0CC"/>
          <Viewbox x:Name="pAvLetter" Stretch="Uniform" Width="124" Height="124" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="100" Height="100"><Path Fill="#FFFFFF" Opacity="0.95"><Path.Data><GeometryGroup><EllipseGeometry Center="50,38" RadiusX="17" RadiusY="17"/><PathGeometry Figures="M 13.4 84 C 16 64 34 57 50 57 C 66 57 84 64 86.6 84 A 50 50 0 0 1 13.4 84 Z"/></GeometryGroup></Path.Data></Path></Canvas></Viewbox>
          <Border Width="36" Height="36" CornerRadius="18" Background="#1B1F24" BorderBrush="#2B3038" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF375F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>
        <TextBlock Text="Click the photo to choose one (optional)" FontSize="12" Foreground="#6B7186" HorizontalAlignment="Center" Margin="0,12,0,14"/>
        <TextBox x:Name="pName" Style="{StaticResource WizText}" Width="280" Height="44" FontSize="16" MaxLength="24" TextAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="pErr" Text="" FontSize="12" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="0,8,0,8" MinHeight="18"/>
        <Button x:Name="pSave" Style="{StaticResource WizBtn}" Content="Save" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
