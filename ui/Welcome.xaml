<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rock Toolbox" Width="560" Height="690" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="#1F2329" BorderBrush="#2B3038" BorderThickness="1" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- @include ui/WizStyles.xaml -->
  </Window.Resources>
  <Grid ClipToBounds="True">
    <!-- soft colour glows that drift slowly behind everything -->
    <Canvas IsHitTestVisible="False">
      <Ellipse x:Name="glowA" Width="460" Height="460" Canvas.Left="-170" Canvas.Top="-120" Opacity="0.55">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#40FF9F0A" Offset="0"/><GradientStop Color="#00FF9F0A" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform X="0" Y="0"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="glowB" Width="520" Height="520" Canvas.Left="250" Canvas.Top="380" Opacity="0.55">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#40BF5AF2" Offset="0"/><GradientStop Color="#00BF5AF2" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform X="0" Y="0"/></Ellipse.RenderTransform>
      </Ellipse>
    </Canvas>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <Button x:Name="wBtnClose" DockPanel.Dock="Right" Style="{StaticResource TitleClose}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
        </Button>
        <TextBlock Text="Rock Toolbox" Margin="14,0" VerticalAlignment="Center" Foreground="#9AA0B8" FontSize="12"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="34,0">

        <!-- 1) welcome: the greeting changes language like on a new iPhone, then settles on "Welcome" -->
        <StackPanel x:Name="pgWelcome" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <Grid x:Name="wGreetHost" Width="460" Height="96" HorizontalAlignment="Center" Background="Transparent" Cursor="Hand" ToolTip="Click to skip">
            <TextBlock x:Name="wGreetA" FontSize="50" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
              <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF9F0A" Offset="0"/><GradientStop Color="#FF375F" Offset="0.5"/><GradientStop Color="#BF5AF2" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
            </TextBlock>
            <TextBlock x:Name="wGreetB" FontSize="50" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
              <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF9F0A" Offset="0"/><GradientStop Color="#FF375F" Offset="0.5"/><GradientStop Color="#BF5AF2" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
            </TextBlock>
          </Grid>
          <TextBlock x:Name="wSub" Text="a new version from Rock Toolbox" FontSize="16" Foreground="#9AA0B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <Border x:Name="wVerPill" Background="#1E3547" CornerRadius="16" Padding="22,6" Margin="0,22,0,0" HorizontalAlignment="Center">
            <TextBlock x:Name="wVer" Text="V4.1.0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#4FD1FF"/>
          </Border>
          <Grid x:Name="wStartHost" HorizontalAlignment="Center" Margin="0,46,0,0">
            <Border x:Name="wStartGlow" CornerRadius="28" Background="#FF375F" Opacity="0" IsHitTestVisible="False"/>
            <Button x:Name="wBtnStart" Style="{StaticResource WizBtn}" Content="Start"/>
          </Grid>
        </StackPanel>

        <!-- 2) language -->
        <StackPanel x:Name="pgLang" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Visibility="Collapsed">
          <TextBlock Text="Choose your language" FontSize="26" FontWeight="Bold" Foreground="#F2F4FF" HorizontalAlignment="Center"/>
          <TextBlock Text="You can change it any time from the gear menu" FontSize="13" Foreground="#9AA0B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <UniformGrid x:Name="wLangGrid" Columns="4" Margin="0,22,0,0"/>
          <StackPanel Margin="0,8,0,0" MinHeight="56">
            <TextBlock x:Name="wLangStatus" Text="" FontSize="12" Foreground="#9AA0B8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <ProgressBar x:Name="wLangPb" Height="6" Width="240" Margin="0,8,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#FF375F" Background="#2B3038" BorderThickness="0"/>
          </StackPanel>
          <Button x:Name="wBtnLangNext" Style="{StaticResource WizBtn}" Content="Next" Margin="0,6,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 3) look -->
        <StackPanel x:Name="pgLook" VerticalAlignment="Center" HorizontalAlignment="Center" Width="470" Visibility="Collapsed">
          <TextBlock Text="Pick your look" FontSize="26" FontWeight="Bold" Foreground="#F2F4FF" HorizontalAlignment="Center"/>
          <TextBlock Text="You can switch any time in Settings" FontSize="13" Foreground="#9AA0B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <UniformGrid Columns="2" Margin="0,26,0,0">
            <Button x:Name="wCardClassic" Tag="Classic" Style="{StaticResource WizCard}">
              <StackPanel>
                <Border Width="170" Height="112" CornerRadius="7" Background="#20252B" ClipToBounds="True">
                  <Grid>
                    <Border Height="14" VerticalAlignment="Top" Background="#191D22"/>
                    <StackPanel Orientation="Horizontal" Margin="9,22,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                      <Border Width="26" Height="10" CornerRadius="2" Background="#2E70B2" Margin="0,0,4,0"/>
                      <Border Width="26" Height="10" CornerRadius="2" Background="#2A3139" Margin="0,0,4,0"/>
                      <Border Width="26" Height="10" CornerRadius="2" Background="#2A3139" Margin="0,0,4,0"/>
                      <Border Width="26" Height="10" CornerRadius="2" Background="#2A3139"/>
                    </StackPanel>
                    <Border Height="7" CornerRadius="2" Background="#2A3139" VerticalAlignment="Top" Margin="9,44,60,0"/>
                    <Border Height="7" CornerRadius="2" Background="#2A3139" VerticalAlignment="Top" Margin="9,57,34,0"/>
                    <Border Height="7" CornerRadius="2" Background="#2A3139" VerticalAlignment="Top" Margin="9,70,80,0"/>
                    <Border Width="46" Height="14" CornerRadius="2.5" Background="#2E70B2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,9"/>
                  </Grid>
                </Border>
                <TextBlock Text="Classic" FontSize="15" FontWeight="Bold" Foreground="#F2F4FF" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Clean and blue" FontSize="12" Foreground="#9AA0B8" HorizontalAlignment="Center" Margin="0,2,0,2"/>
              </StackPanel>
            </Button>
            <Button x:Name="wCardModern" Tag="Modern" Style="{StaticResource WizCard}">
              <StackPanel>
                <Border Width="170" Height="112" CornerRadius="14" Background="#20252B" ClipToBounds="True">
                  <Grid>
                    <Border Width="40" HorizontalAlignment="Left" Margin="7" CornerRadius="9" Background="#191D22"/>
                    <StackPanel Margin="13,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <Border Width="28" Height="9" CornerRadius="5" Margin="0,0,0,6">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF9F0A" Offset="0"/><GradientStop Color="#FF375F" Offset="0.55"/><GradientStop Color="#BF5AF2" Offset="1"/></LinearGradientBrush></Border.Background>
                      </Border>
                      <Border Width="28" Height="9" CornerRadius="5" Background="#2A3139" Margin="0,0,0,6"/>
                      <Border Width="28" Height="9" CornerRadius="5" Background="#2A3139" Margin="0,0,0,6"/>
                      <Border Width="28" Height="9" CornerRadius="5" Background="#2A3139"/>
                    </StackPanel>
                    <Border Height="14" CornerRadius="7" Background="#2A3139" VerticalAlignment="Top" Margin="56,14,14,0"/>
                    <Border Height="14" CornerRadius="7" Background="#2A3139" VerticalAlignment="Top" Margin="56,36,34,0"/>
                    <Border Width="48" Height="17" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF9F0A" Offset="0"/><GradientStop Color="#FF375F" Offset="0.55"/><GradientStop Color="#BF5AF2" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                  </Grid>
                </Border>
                <TextBlock Text="Modern" FontSize="15" FontWeight="Bold" Foreground="#F2F4FF" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Colorful and rounded" FontSize="12" Foreground="#9AA0B8" HorizontalAlignment="Center" Margin="0,2,0,2"/>
              </StackPanel>
            </Button>
          </UniformGrid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
            <Button x:Name="wChipLight" Tag="Light" Style="{StaticResource WizChip}" Content="Light"/>
            <Button x:Name="wChipDark" Tag="Dark" Style="{StaticResource WizChip}" Content="Dark"/>
          </StackPanel>
          <Button x:Name="wBtnLookNext" Style="{StaticResource WizBtn}" Content="Next" Margin="0,26,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 4) profile -->
        <StackPanel x:Name="pgProfile" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Visibility="Collapsed">
          <TextBlock Text="Who are you?" FontSize="26" FontWeight="Bold" Foreground="#F2F4FF" HorizontalAlignment="Center"/>
          <TextBlock Text="Add a photo and your name" FontSize="13" Foreground="#9AA0B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <Grid x:Name="wAvatarGrid" Tag="pop" Width="140" Height="140" Margin="0,22,0,0" Cursor="Hand" Background="Transparent">
            <Ellipse x:Name="wAvEl" Fill="#B8C0CC"/>
            <Viewbox x:Name="wAvLetter" Stretch="Uniform" Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="100" Height="100"><Path Fill="#FFFFFF" Opacity="0.95"><Path.Data><GeometryGroup><EllipseGeometry Center="50,38" RadiusX="17" RadiusY="17"/><PathGeometry Figures="M 13.4 84 C 16 64 34 57 50 57 C 66 57 84 64 86.6 84 A 50 50 0 0 1 13.4 84 Z"/></GeometryGroup></Path.Data></Path></Canvas></Viewbox>
            <Border Width="38" Height="38" CornerRadius="19" Background="#1B1F24" BorderBrush="#2B3038" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#FF375F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <TextBlock Text="Click the photo to choose one (optional)" FontSize="12" Foreground="#6B7186" HorizontalAlignment="Center" Margin="0,12,0,16"/>
          <TextBox x:Name="wName" Style="{StaticResource WizText}" Width="280" Height="46" FontSize="17" MaxLength="24" TextAlignment="Center" VerticalContentAlignment="Center"/>
          <TextBlock x:Name="wNameErr" Text="" FontSize="12" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="0,8,0,8" MinHeight="18"/>
          <Button x:Name="wBtnProfNext" Style="{StaticResource WizBtn}" Content="Next" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 5) done -->
        <StackPanel x:Name="pgDone" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" Visibility="Collapsed">
          <Grid Tag="pop" Width="116" Height="116" HorizontalAlignment="Center">
            <Ellipse x:Name="wDoneRing" Stroke="#FF375F" StrokeThickness="3" Opacity="0" IsHitTestVisible="False"/>
            <Ellipse x:Name="wDoneAv" Fill="#B8C0CC" Margin="6"/>
            <Viewbox x:Name="wDoneLetter" Stretch="Uniform" Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="100" Height="100"><Path Fill="#FFFFFF" Opacity="0.95"><Path.Data><GeometryGroup><EllipseGeometry Center="50,38" RadiusX="17" RadiusY="17"/><PathGeometry Figures="M 13.4 84 C 16 64 34 57 50 57 C 66 57 84 64 86.6 84 A 50 50 0 0 1 13.4 84 Z"/></GeometryGroup></Path.Data></Path></Canvas></Viewbox>
          </Grid>
          <TextBlock x:Name="wDoneTitle" Text="Welcome" FontSize="30" FontWeight="Bold" Foreground="#F2F4FF" HorizontalAlignment="Center" Margin="0,18,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="Your toolbox is ready." FontSize="15" Foreground="#C9CDE0" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          <TextBlock Text="Install apps, tune Windows and clean up in a few clicks." FontSize="13" Foreground="#9AA0B8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock Text="Tip: change the language, look and your profile from the gear menu." FontSize="12" Foreground="#6B7186" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
          <Button x:Name="wBtnFinish" Style="{StaticResource WizBtn}" Content="Finish" Margin="0,32,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 6) applying -->
        <StackPanel x:Name="pgRestart" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <Ellipse x:Name="wSpin" Width="48" Height="48" Stroke="#FF375F" StrokeThickness="4" StrokeDashArray="5 4" HorizontalAlignment="Center"/>
          <TextBlock Text="Restarting Rock Toolbox" FontSize="20" FontWeight="Bold" Foreground="#F2F4FF" HorizontalAlignment="Center" Margin="0,20,0,0"/>
          <TextBlock Text="Applying your settings..." FontSize="13" Foreground="#9AA0B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          <ProgressBar x:Name="wRestartPb" Minimum="0" Maximum="100" Value="0" Height="6" Width="260" Margin="0,18,0,0" Foreground="#FF375F" Background="#2B3038" BorderThickness="0"/>
        </StackPanel>

      </Grid>
      <StackPanel x:Name="spDots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
