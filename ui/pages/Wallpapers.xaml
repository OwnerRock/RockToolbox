      <!-- WALLPAPERS -->
      <DockPanel x:Name="pnlWall" Visibility="Collapsed">
        <Border x:Name="brWpHead" DockPanel.Dock="Top" Background="#1B1F24" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="Wallpapers" FontSize="18" FontWeight="SemiBold" Foreground="#F2F4FF"/>
            <WrapPanel x:Name="wpWpBar1" Margin="0,10,0,0">
              <TextBox x:Name="txtWpQuery" Width="420" Height="34" Margin="3" FontSize="14" Padding="8,0" VerticalContentAlignment="Center"
                       ToolTip="Type what you want to see: mountains at night, cyberpunk city, red sports car..."/>
              <Button x:Name="btnWpSearch" Content="Search" Background="#2F6FB0" Padding="28,7"/>
              <Button x:Name="btnWpSimilar" Content="Find similar" Padding="18,7" ToolTip="Click a picture first, then press this to see more like it"/>
              <Button x:Name="btnWpMore" Content="More results" Padding="18,7"/>
              <Button x:Name="btnWpMine" Content="My pictures" Padding="18,7" ToolTip="Show pictures from your computer (works without internet)"/>
              <Button x:Name="btnWpFolder" Content="Choose folder..." Padding="18,7" ToolTip="Pick another folder with pictures"/>
              <Button x:Name="btnWpAdd" Content="Add pictures..." Padding="18,7" ToolTip="Copy pictures into the Rock Toolbox wallpaper folder"/>
            </WrapPanel>
            <WrapPanel x:Name="wpChips" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="brWpTools" DockPanel.Dock="Top" Background="#1B1F24" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
          <StackPanel>
            <WrapPanel x:Name="wpWpBar2">
              <TextBlock Text="Apply" Foreground="#9AA0B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,0" Width="52"/>
              <ComboBox x:Name="cmbWpStyle" Width="110" Height="30" Margin="3" VerticalContentAlignment="Center"/>
              <Button x:Name="btnWpSet" Content="Set as wallpaper"/>
              <Button x:Name="btnWpLock" Content="Set as lock screen"/>
              <Button x:Name="btnWpBoth" Content="Set both" Background="#2F6FB0"/>
              <Button x:Name="btnWpSave" Content="Save to Pictures"/>
            </WrapPanel>
            <WrapPanel Margin="0,2,0,0">
              <TextBlock Text="More" Foreground="#9AA0B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,0" Width="52"/>
              <Button x:Name="btnWpRandom" Content="Random from list"/>
              <Button x:Name="btnWpLocal" Content="Desktop from local image..."/>
              <Button x:Name="btnWpLockLocal" Content="Lock screen from local image..."/>
              <Button x:Name="btnWpDailyOn" Content="Enable daily Bing wallpaper"/>
              <Button x:Name="btnWpDailyOff" Content="Disable daily"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <TextBlock x:Name="txtWpInfo" DockPanel.Dock="Bottom" Foreground="#9AA0B8" Margin="8,6" TextWrapping="Wrap"
                   Text="Type a word and press Search. Click a picture to select it, double-click to apply it, or press Find similar to see more like it."/>
        <Border x:Name="brWpList" Background="#1B1F24" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="8">
          <ScrollViewer x:Name="wpScroll" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="wpPanel" Margin="6"/>
          </ScrollViewer>
        </Border>
      </DockPanel>
