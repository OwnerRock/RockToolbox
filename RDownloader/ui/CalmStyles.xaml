    <!-- shared look of the download windows (Download File Info, progress, Rlist): calm, classic, soft blue-green -->
    <Style x:Key="CalmClose" TargetType="Button">
      <Setter Property="Width" Value="44"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8895A6"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="bd" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#D9534F"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#B94441"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CalmMin" TargetType="Button" BasedOn="{StaticResource CalmClose}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="bd" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2A323C"/><Setter Property="Foreground" Value="#E4E9F0"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#313B47"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- main button: soft blue-green gradient, grows a little on hover, squeezes when pressed -->
    <Style x:Key="CalmBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="20,8"/><Setter Property="Margin" Value="5,0"/>
      <Setter Property="MinWidth" Value="104"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#4DA3C4" Offset="0"/><GradientStop Color="#4FB7A8" Offset="1"/></LinearGradientBrush></Border.Background>
          <Border.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.14"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.14"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.07"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.07"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- quiet button: dark panel with a thin border that turns blue-green on hover -->
    <Style x:Key="CalmGhost" TargetType="Button" BasedOn="{StaticResource CalmBtn}">
      <Setter Property="Foreground" Value="#E4E9F0"/><Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="#232A33" BorderBrush="#313B47" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="bd" Property="BorderBrush" Value="#4DA3C4"/><Setter TargetName="bd" Property="Background" Value="#28313B"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.14"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.14"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.07"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.07"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- tab header: text with a blue-green line under the selected one -->
    <Style x:Key="CalmTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#8895A6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="bd" Padding="18,9" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#E4E9F0"/><Setter TargetName="bd" Property="Background" Value="#202730"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#E4E9F0"/><Setter TargetName="bd" Property="BorderBrush" Value="#4DA3C4"/><Setter TargetName="bd" Property="Background" Value="#232A33"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="CalmBox" TargetType="TextBox">
      <Setter Property="Background" Value="#1F252D"/><Setter Property="Foreground" Value="#E4E9F0"/><Setter Property="CaretBrush" Value="#E4E9F0"/>
      <Setter Property="BorderBrush" Value="#313B47"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="SelectionBrush" Value="#4DA3C4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Focusable="False"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#46525F"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#4DA3C4"/></Trigger>
          <Trigger Property="IsReadOnly" Value="True"><Setter Property="Foreground" Value="#AAB6C4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="CalmBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="Background" Value="#2A323C"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid x:Name="TemplateRoot">
          <Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="#313B47" BorderThickness="1"/>
          <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5" Margin="1" ClipToBounds="True">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#4DA3C4" Offset="0"/><GradientStop Color="#4FB7A8" Offset="1"/></LinearGradientBrush></Border.Background>
            <Border CornerRadius="5">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop x:Name="sh1" Color="#00FFFFFF" Offset="-0.3"/><GradientStop x:Name="sh2" Color="#66FFFFFF" Offset="-0.15"/><GradientStop x:Name="sh3" Color="#00FFFFFF" Offset="0"/>
              </LinearGradientBrush></Border.Background>
            </Border>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard><Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetName="sh1" Storyboard.TargetProperty="Offset" From="-0.3" To="1.0" Duration="0:0:1.6"/>
              <DoubleAnimation Storyboard.TargetName="sh2" Storyboard.TargetProperty="Offset" From="-0.15" To="1.15" Duration="0:0:1.6"/>
              <DoubleAnimation Storyboard.TargetName="sh3" Storyboard.TargetProperty="Offset" From="0" To="1.3" Duration="0:0:1.6"/>
            </Storyboard></BeginStoryboard>
          </EventTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- thin rounded scroll bars that glow when you point at them -->
    <Style x:Key="CalmPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CalmThumb" TargetType="Thumb">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Border x:Name="th" CornerRadius="4" Margin="2" Background="#46525F"/>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="th" Property="Background" Value="#4DA3C4"/><Setter TargetName="th" Property="Margin" Value="1"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="th" Property="Background" Value="#4FB7A8"/><Setter TargetName="th" Property="Margin" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="11"/><Setter Property="MinWidth" Value="11"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource CalmPage}"/></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource CalmPage}"/></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource CalmThumb}"/></Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="11"/><Setter Property="MinHeight" Value="11"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource CalmPage}"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource CalmPage}"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource CalmThumb}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CalmCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E4E9F0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/><Setter Property="Margin" Value="0,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="bx" Width="18" Height="18" CornerRadius="5" Background="#1F252D" BorderBrush="#46525F" BorderThickness="1" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <Path x:Name="ck" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" Stretch="Uniform" Margin="3"/>
          </Border>
          <ContentPresenter VerticalAlignment="Center" Margin="9,0,0,0"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bx" Property="BorderBrush" Value="#4DA3C4"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="bx" Property="Background" Value="#4DA3C4"/><Setter TargetName="bx" Property="BorderBrush" Value="#4FB7A8"/><Setter TargetName="ck" Property="Opacity" Value="1"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" From="0.7" To="1" Duration="0:0:0.18"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" From="0.7" To="1" Duration="0:0:0.18"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- item of the small pop-up menus (Add to Rlist ...) -->
    <Style x:Key="CalmMenuItem" TargetType="Button">
      <Setter Property="Foreground" Value="#E4E9F0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="bd" CornerRadius="6" Padding="12,8" Background="Transparent" Margin="2">
          <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2D3743"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#364352"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
