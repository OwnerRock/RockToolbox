<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="R-Downloader - Grabber" Width="620" Height="520" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Background="#1B2027" BorderBrush="#313B47" BorderThickness="1" FontFamily="Segoe UI" FontSize="12" Foreground="#E4E9F0" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- @include ui/CalmStyles.xaml -->
  </Window.Resources>
  <Grid x:Name="root">
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#171C22" BorderBrush="#2A323C" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button x:Name="btnClose" DockPanel.Dock="Right" Width="40" Style="{StaticResource CalmClose}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
          </Button>
          <Button x:Name="btnMin" DockPanel.Dock="Right" Width="40" Style="{StaticResource CalmMin}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="10" Height="2"/>
          </Button>
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#4DA3C4" FontSize="13" VerticalAlignment="Center" Margin="11,0,8,0"/>
          <TextBlock x:Name="txtTitle" Text="Grabber" VerticalAlignment="Center" Foreground="#C9D2DD" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>

    <Grid Grid.Row="1" Margin="16,12,16,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Collect every download link of a web page (files, videos, archives...) and pick the ones you want." Foreground="#8895A6" TextWrapping="Wrap"/>
      <Grid Grid.Row="1" Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="txtPage" Style="{StaticResource CalmBox}" Height="30" VerticalContentAlignment="Center" ToolTip="Address of the web page"/>
        <Button x:Name="btnScan" Grid.Column="1" Content="Scan" Style="{StaticResource CalmBtn}" Padding="14,6" MinWidth="88" Margin="8,0,0,0"/>
      </Grid>
      <Grid Grid.Row="2" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="File types" Foreground="#8895A6" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="txtTypes" Grid.Column="1" Style="{StaticResource CalmBox}" Height="30" VerticalContentAlignment="Center" ToolTip="For example: zip, pdf, mp4. Empty = every file link"/>
      </Grid>
      <Border Grid.Row="3" Margin="0,10,0,0" Background="#1F252D" BorderBrush="#313B47" BorderThickness="1" CornerRadius="6">
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstLinks" Margin="8,6">
              <ItemsControl.ItemTemplate><DataTemplate>
                <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Style="{StaticResource CalmCheck}" Margin="0,2" ToolTip="{Binding Url}">
                  <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" MaxWidth="500" FontFamily="Consolas" FontSize="11.5"/>
                </CheckBox>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock x:Name="txtEmpty" Text="Type the address of a page and press Scan." Foreground="#8895A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <Grid Grid.Row="4" Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="btnAll" Content="Select all" Style="{StaticResource CalmGhost}" Padding="10,5" MinWidth="0"/>
          <Button x:Name="btnNone" Content="Select none" Style="{StaticResource CalmGhost}" Padding="10,5" MinWidth="0" Margin="6,0,0,0"/>
          <TextBlock x:Name="txtCount" Foreground="#8895A6" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="btnGet" Content="Download selected" Style="{StaticResource CalmBtn}" Padding="12,6" MinWidth="0"/>
          <Button x:Name="btnShut" Content="Close" Style="{StaticResource CalmGhost}" Padding="12,6" MinWidth="80" Margin="6,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
    <TextBlock x:Name="txtState" Visibility="Collapsed"/>
  </Grid>
</Window>
