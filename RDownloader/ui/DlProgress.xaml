<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="R-Downloader download" Width="580" Height="440" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Background="#1B2027" BorderBrush="#313B47" BorderThickness="1" FontFamily="Segoe UI" FontSize="12" Foreground="#E4E9F0" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- @include ui/CalmStyles.xaml -->
  </Window.Resources>
  <Grid x:Name="root">
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#171C22" BorderBrush="#2A323C" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button x:Name="btnClose" DockPanel.Dock="Right" Width="40" Style="{StaticResource CalmClose}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
          </Button>
          <Button x:Name="btnMin" DockPanel.Dock="Right" Width="40" Style="{StaticResource CalmMin}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="10" Height="2"/>
          </Button>
          <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="#4DA3C4" FontSize="13" VerticalAlignment="Center" Margin="11,0,8,0"/>
          <TextBlock x:Name="txtTitle" Text="Download" VerticalAlignment="Center" Foreground="#C9D2DD" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>

    <Grid Grid.Row="1" Margin="10,8,10,10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <RadioButton x:Name="tabStatus" Content="Download status" GroupName="dltabs" IsChecked="True" Style="{StaticResource CalmTab}"/>
        <RadioButton x:Name="tabLimit" Content="Speed Limiter" GroupName="dltabs" Style="{StaticResource CalmTab}"/>
        <RadioButton x:Name="tabDone" Content="Options on completion" GroupName="dltabs" Style="{StaticResource CalmTab}"/>
      </StackPanel>
      <Border Grid.Row="1" x:Name="cardInfo" Background="#232A33" BorderBrush="#313B47" BorderThickness="1" CornerRadius="0,8,8,8" Padding="14,8" Height="152">
        <Grid>
          <Grid x:Name="pageStatus">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
            <TextBlock x:Name="vUrl" Grid.ColumnSpan="2" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Status" Foreground="#8895A6" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="dot" Width="8" Height="8" Fill="#52B788" Margin="0,0,7,0"/><TextBlock x:Name="vStatus"/></StackPanel>
            <TextBlock Grid.Row="2" Text="File size" Foreground="#8895A6" VerticalAlignment="Center"/><TextBlock x:Name="vSize" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Text="Downloaded" Foreground="#8895A6" VerticalAlignment="Center"/><TextBlock x:Name="vDone" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="4" Text="Transfer rate" Foreground="#8895A6" VerticalAlignment="Center"/><TextBlock x:Name="vRate" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="5" Text="Time left" Foreground="#8895A6" VerticalAlignment="Center"/><TextBlock x:Name="vEta" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="6" Text="Resume capability" Foreground="#8895A6" VerticalAlignment="Center"/><TextBlock x:Name="vResume" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel x:Name="pageLimit" Visibility="Collapsed" VerticalAlignment="Center">
            <CheckBox x:Name="chkLimit" Content="Use the speed limiter for this file" Style="{StaticResource CalmCheck}"/>
            <StackPanel Orientation="Horizontal" Margin="27,6,0,0">
              <TextBlock Text="Maximum speed" Foreground="#8895A6" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="txtLimit" Style="{StaticResource CalmBox}" Width="86" Text="1024"/>
              <TextBlock Text="KB/s" Foreground="#8895A6" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="pageDone" Visibility="Collapsed" VerticalAlignment="Center">
            <CheckBox x:Name="chkOpenFile" Content="Open the file when it finishes" Style="{StaticResource CalmCheck}"/>
            <CheckBox x:Name="chkOpenFolder" Content="Show the file in its folder" Style="{StaticResource CalmCheck}"/>
            <CheckBox x:Name="chkClose" Content="Close this window when it finishes" Style="{StaticResource CalmCheck}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,10,0,0">
        <ProgressBar x:Name="bar" Style="{StaticResource CalmBar}" Height="20" Value="0"/>
        <TextBlock x:Name="barText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
      </Grid>
      <Grid Grid.Row="3" Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="btnHide" Content="&lt;&lt; Hide details" Style="{StaticResource CalmGhost}" Margin="0" Padding="12,6" MinWidth="116"/>
        <Button x:Name="btnPause" Grid.Column="2" Content="Pause" Style="{StaticResource CalmBtn}" Padding="12,6" MinWidth="104"/>
        <Button x:Name="btnCancel" Grid.Column="3" Content="Cancel" Style="{StaticResource CalmGhost}" Margin="6,0,0,0" Padding="12,6" MinWidth="104"/>
      </Grid>
      <Grid x:Name="gridConn" Grid.Row="4" Margin="0,10,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Start positions and download progress by connections" Foreground="#AAB6C4" HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <Border Grid.Row="1" Height="14" Background="#2A323C" BorderBrush="#313B47" BorderThickness="1" CornerRadius="3" ClipToBounds="True"><Canvas x:Name="cnv" ClipToBounds="True"/></Border>
        <Border Grid.Row="2" Margin="0,8,0,0" Background="#1F252D" BorderBrush="#313B47" BorderThickness="1" CornerRadius="6">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#232A33" BorderBrush="#313B47" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="10,4">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="N." Foreground="#8895A6"/><TextBlock Grid.Column="1" Text="Downloaded" Foreground="#8895A6"/><TextBlock Grid.Column="2" Text="Info" Foreground="#8895A6"/></Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="lstConn" AlternationCount="2">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border x:Name="rowBg" Padding="10,3" Background="Transparent">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding N}" Foreground="#8895A6"/>
                      <TextBlock Grid.Column="1" Text="{Binding Downloaded}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Info}" Foreground="#AAB6C4"/>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ItemsControl.AlternationIndex)}" Value="0"><Setter TargetName="rowBg" Property="Background" Value="#26303A"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <TextBlock x:Name="txtState" Visibility="Collapsed"/><TextBlock x:Name="txtPath" Visibility="Collapsed"/>
  </Grid>
</Window>
