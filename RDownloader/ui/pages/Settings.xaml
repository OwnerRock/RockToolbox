      <!-- SETTINGS -->
      <ScrollViewer x:Name="pnlSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="20,10">
          <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="Customize how R-Downloader looks and behaves. Changes apply instantly and are saved automatically." Foreground="#C9CDE0" Margin="0,4,0,18" TextWrapping="Wrap"/>

          <Border Background="#23272D" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Appearance" Style="{StaticResource H}" Margin="0,0,0,8"/>
              <CheckBox x:Name="chkDark" Style="{StaticResource Switch}" Content="Dark mode"/>
              <CheckBox x:Name="chkClassic" Style="{StaticResource Switch}" Content="Classic look (old interface)"/>
              <TextBlock Text="Switches between the new and the classic look instantly." Foreground="#9AA0B8" FontSize="11.5" Margin="30,0,0,6"/>
              <TextBlock Text="Language" Foreground="#C9CDE0" Margin="4,12,0,6"/>
              <ComboBox x:Name="cmbLang" Width="230" Height="30" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
          </Border>

          <Border Background="#23272D" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Program" Style="{StaticResource H}" Margin="0,0,0,8"/>
              <CheckBox x:Name="chkStartup" Style="{StaticResource Switch}" Content="Start R-Downloader with Windows"/>
              <TextBlock Text="It starts hidden in the tray, so browser downloads are caught from the first second." Foreground="#9AA0B8" FontSize="11.5" Margin="30,0,0,6"/><CheckBox x:Name="chkTray" Style="{StaticResource Switch}" Content="Keep running in the tray when the window is closed"/>
              <CheckBox x:Name="chkTop" Style="{StaticResource Switch}" Content="Keep the window on top"/>
              
            </StackPanel>
          </Border>

          <Border Background="#23272D" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Downloads" Style="{StaticResource H}" Margin="0,0,0,8"/>
              <CheckBox x:Name="chkSound" Style="{StaticResource Switch}" Content="Play a sound when a download finishes"/>
              <CheckBox x:Name="chkClip" Style="{StaticResource Switch}" Content="Watch the clipboard for download links"/>
              <TextBlock Text="When you copy a link to a file, R-Downloader offers to download it." Foreground="#9AA0B8" FontSize="11.5" Margin="30,0,0,6"/>
              <TextBlock Text="When all downloads are finished" Foreground="#C9CDE0" Margin="4,12,0,6"/>
              <ComboBox x:Name="cmbAfter" Width="230" Height="30" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
          </Border>

          <Border Background="#23272D" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Browser and files" Style="{StaticResource H}" Margin="0,0,0,8"/>
              <CheckBox x:Name="chkRlist" Style="{StaticResource Switch}" Content="Open .Rlist files with R-Downloader"/>
              <TextBlock Text="Double-click a .Rlist file to open it here, without a Yes / No (UAC) prompt." Foreground="#9AA0B8" FontSize="11.5" Margin="30,0,0,6"/>
              <WrapPanel Margin="0,6,0,0">
                <Button x:Name="btnSetExt" Content="Browser extension..." Padding="18,6"/>
                <Button x:Name="btnSetData" Content="Open the data folder" Padding="18,6"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Background="#23272D" BorderBrush="#2B3038" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="About" Style="{StaticResource H}" Margin="0,0,0,8"/>
              <TextBlock x:Name="txtAbout" Foreground="#C9CDE0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
